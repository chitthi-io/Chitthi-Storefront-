# ---- OS noise ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- Logs ----
*.log
npm-debug.log*

# ---- Dependencies / build (not used today, guarded for later) ----
node_modules/
dist/
build/
.cache/
.parcel-cache/

# ---- Environment / secrets ----
.env
.env.*
*.pem
.netrc

# ---- Working files that should not ship ----
/private/
/client-assets/
*.psd
*.fig

# working dirs, not part of the storefront
/backups/
/build-*/
/uploads/

# home-directory noise created by toolchains (apt, playwright, chromium)
/.config/
/.local/
/.cache/
/.npm/
/.pki/
/.mozilla/
/.dbus/
/.sudo_as_admin_successful

# generated thumbnails are build output, not source
/thumbnails/
